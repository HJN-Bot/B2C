# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Deepgram Nova-2 — mobile cloud STT (src/lib/cloud-stt.ts)
# Get a key at https://console.deepgram.com (free 200h/month).
# Also set this same var in the EdgeOne / Vercel build env, and add the
# deploy domains to the Deepgram Console domain allowlist:
#   *.edgeone.cool  *.vercel.app  localhost
VITE_DEEPGRAM_API_KEY=

# Optional: local Gemini key fallback (normally fetched via Supabase Edge Function)
# VITE_GEMINI_API_KEY=
