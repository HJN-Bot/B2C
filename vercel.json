{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": "vite",
  "rewrites": [
    { "source": "/guide.html", "destination": "/guide.html" },
    { "source": "/guide/:path*", "destination": "/guide/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
